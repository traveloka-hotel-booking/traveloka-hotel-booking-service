# Kích hoạt môi trường (local hoặc prod)
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# Cấu hình Cơ sở dữ liệu Local
DB_LOCAL_URL=jdbc:mysql://localhost:3306/traveloka-hotel-db
DB_LOCAL_USERNAME=your_local_db_username
DB_LOCAL_PASSWORD=your_local_db_password

# Cấu hình Cơ sở dữ liệu Production
DB_PRODUCTION_URL=jdbc:mysql://your_prod_host:3306/traveloka-hotel-db
DB_PRODUCTION_USERNAME=your_prod_db_username
DB_PRODUCTION_PASSWORD=your_prod_db_password

# Bảo mật JWT (Tối thiểu 256 bits)
JWT_SECRET=your_jwt_secret_key_minimum_256_bits

# Cấu hình gửi Mail SMTP (Gmail)
MAIL_USERNAME=your_gmail_address@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# Dịch vụ Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Cổng thanh toán VNPay Sandbox
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/payment-callback

# Dịch vụ Google Maps API (Tùy chọn)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Bộ nhớ đệm Redis
REDIS_LOCAL_HOST=localhost
REDIS_LOCAL_PORT=6379
REDIS_PRODUCTION_HOST=your_prod_redis_host
REDIS_PRODUCTION_PORT=6379

# Tên miền Frontend
APP_FRONTEND_URL=http://localhost:5173
DOMAIN_FRONT_END_PRODUCTION=https://your-production-domain.com
